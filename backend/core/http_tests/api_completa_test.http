###############################################
# 🚀 PRUEBAS RÁPIDAS PARA VERIFICAR
###############################################

### 1. Verificar que la API está funcionando
GET {{base_url}}/api/
Content-Type: application/json
Authorization: Bearer {{token}}

### 2. Listar todos los clientes (debe mostrar datos de tu BD)
GET {{api_url}}/clientes/
Content-Type: application/json
Authorization: Bearer {{token}}

### 3. Listar todos los empleados (debe mostrar datos de tu BD)
GET {{api_url}}/empleados/
Content-Type: application/json
Authorization: Bearer {{token}}

### 4. Listar todas las pilas (debe mostrar datos de tu BD)
GET {{api_url}}/pilas/
Content-Type: application/json
Authorization: Bearer {{token}}

### 5. Listar todos los relojes (debe mostrar datos de tu BD)
GET {{api_url}}/relojes/
Content-Type: application/json
Authorization: Bearer {{token}}

### 6. Listar todas las reparaciones (debe mostrar datos de tu BD)
GET {{api_url}}/reparaciones/
Content-Type: application/json
Authorization: Bearer {{token}}

### 7. Listar todos los ingresos (debe mostrar datos de tu BD)
GET {{api_url}}/ingresos/
Content-Type: application/json
Authorization: Bearer {{token}}

### 8. Listar todos los egresos (debe mostrar datos de tu BD)
GET {{api_url}}/egresos/
Content-Type: application/json
Authorization: Bearer {{token}}

### 9. Listar todas las ventas de pilas (debe mostrar datos de tu BD)
GET {{api_url}}/ventas-pilas/
Content-Type: application/json
Authorization: Bearer {{token}}

### 10. Listar todos los abonos (debe mostrar datos de tu BD)
GET {{api_url}}/abonos/?page=2
Content-Type: application/json
Authorization: Bearer {{token}}

###############################################
# 📊 ENDPOINTS ÚTILES PARA DASHBOARDS
###############################################

### Obtener técnicos activos
GET {{api_url}}/empleados/tecnicos/
Content-Type: application/json
Authorization: Bearer {{token}}

### Obtener reparaciones pendientes
GET {{api_url}}/reparaciones/pendientes/
Content-Type: application/json
Authorization: Bearer {{token}}

### Obtener reparaciones retrasadas
GET {{api_url}}/reparaciones/retrasadas/
Content-Type: application/json
Authorization: Bearer {{token}}

### Obtener relojes disponibles
GET {{api_url}}/relojes/disponibles/
Content-Type: application/json
Authorization: Bearer {{token}}

### Obtener relojes con saldo pendiente
GET {{api_url}}/relojes/pendientes_pago/
Content-Type: application/json
Authorization: Bearer {{token}}

### Obtener pilas con bajo stock
GET {{api_url}}/pilas/bajo_stock/?minimo=10
Content-Type: application/json
Authorization: Bearer {{token}}

### Obtener total de ingresos del mes
GET {{api_url}}/ingresos/total_mes/
Content-Type: application/json
Authorization: Bearer {{token}}

### Obtener total de egresos del mes
GET {{api_url}}/egresos/total_mes/
Content-Type: application/json
Authorization: Bearer {{token}}

### Obtener estadísticas de reparaciones por estado
GET {{api_url}}/reparaciones/por_estado/
Content-Type: application/json
Authorization: Bearer {{token}}

###############################################
# 🔍 BÚSQUEDAS Y FILTROS
###############################################

### Buscar clientes por nombre
GET {{api_url}}/clientes/?search=Juan
Content-Type: application/json
Authorization: Bearer {{token}}

### Buscar reparaciones por código
GET {{api_url}}/reparaciones/?search=ORD-
Content-Type: application/json
Authorization: Bearer {{token}}

### Filtrar reparaciones por estado
GET {{api_url}}/reparaciones/?estado=Reparación
Content-Type: application/json
Authorization: Bearer {{token}}

### Buscar relojes por marca
GET {{api_url}}/relojes/?search=Rolex
Content-Type: application/json
Authorization: Bearer {{token}}

### Filtrar relojes disponibles
GET {{api_url}}/relojes/?estado=DISPONIBLE
Content-Type: application/json
Authorization: Bearer {{token}}

###############################################
# 📝 NOTAS IMPORTANTES
###############################################

# 1. AUTENTICACIÓN
#    Actualmente la API no requiere autenticación.
#    Cuando implementes el frontend separado, considera agregar JWT.

# 2. PAGINACIÓN
#    DRF incluye paginación por defecto. Verifica settings.py
#    para configurar el tamaño de página.

# 3. CORS
#    Ya tienes corsheaders instalado. Configura CORS_ALLOWED_ORIGINS
#    en settings.py para tu frontend.

# 4. VALIDACIONES
#    Todos los serializers incluyen validaciones robustas.
#    Los errores retornan código 400 con detalles del error.

# 5. RELACIONES
#    Los endpoints incluyen datos anidados para lectura (GET)
#    y aceptan solo IDs para escritura (POST/PUT/PATCH).

# 6. CAMPOS CALCULADOS
#    Muchos modelos incluyen campos calculados como:
#    - precio_total en VentaPila
#    - dias_desde_ingreso en Reparacion
#    - porcentaje_pagado en Reloj
#    Estos son de solo lectura.

# 7. ARCHIVOS DE PRUEBA
#    Revisa los archivos individuales para tests detallados:
#    - pilas_test.http
#    - ingresos_test.http
#    - egresos_test.http
#    - relojes_test.http
#    - abonos_test.http
#    - reparaciones_test.http
#    - ventas_pilas_test.http
